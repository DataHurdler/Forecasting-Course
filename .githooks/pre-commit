#!/usr/bin/env bash
#
# Pre-commit quality gate for the academic-workflow template.
#
# This closes the "a direct `git commit` bypasses every gate" hole: the
# full backtest suite + the quality score now run on EVERY commit, not
# only when you go through the skill.
#
# Install once per clone:   ./scripts/install-hooks.sh
# (sets core.hooksPath=.githooks so git finds this version-controlled hook.)
#
# It runs two gates against the STAGED changes and aborts the commit on
# failure:
#   1. Surface-sync (ALWAYS): count + enumerative-table-row consistency,
#      skill integrity, model-version currency — deterministic and fast.
#   2. Quality score (>= 80) on staged .qmd / .tex / .R files with rubrics.
#
# Escape hatches (use sparingly; record the reason in the commit message):
#   SKIP_QUALITY_GATE=1 git commit ...   # skip only the quality score
#   git commit --no-verify ...           # skip ALL hooks (last resort)
#
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-commit: not inside a git work tree" >&2
    exit 2
}
cd "$REPO_ROOT" || exit 2

# Validate the WORKING TREE, deliberately — we do not stash.
#
# This hook used to isolate the staged index with `git stash push --keep-index`
# and pop it back from an EXIT trap. That is the textbook recipe and it failed
# repeatedly here: on 2026-08-31 it left EIGHT unpopped "pre-commit-gate" stashes
# in a single day, four of them after the render side effect that was the first
# suspected cause had already been fixed. Each failure printed "could not
# auto-restore unstaged changes" — meaning a developer's uncommitted work was
# sitting in a stash they had to know to recover by hand.
#
# The trade is worth naming. Validating the working tree means a commit can pass
# because of changes that are NOT in it — you could stage a broken file, fix it
# without staging the fix, and commit the broken version green. In exchange we
# lose an entire class of failure: no stash conflicts, no conflict markers written
# into source, no silently orphaned work. The hook already fell back to this
# behaviour whenever a file had both staged and unstaged changes, so this makes
# the safe path the only path rather than the exception.
#
# If you want true index isolation later, do it without touching the developer's
# tree: `git worktree add` a temporary checkout of the index and run the gates
# there.
_unstaged="$(git diff --name-only 2>/dev/null | grep -c . || true)"
if [ "${_unstaged:-0}" -gt 0 ] 2>/dev/null; then
    echo "ℹ pre-commit: ${_unstaged} file(s) modified but not staged — gates run against the" >&2
    echo "  WORKING TREE, so they see those changes too. Nothing is stashed." >&2
fi

FAIL=0

echo "── pre-commit: backtest (full gate suite — see scripts/backtest.sh) ──"
./scripts/backtest.sh
[ $? -ne 0 ] && FAIL=1

if [ "${SKIP_QUALITY_GATE:-0}" = "1" ]; then
    echo ""
    echo "── pre-commit: quality gate SKIPPED (SKIP_QUALITY_GATE=1) ──"
else
    # Staged, added-or-modified files that have quality rubrics.
    STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -Ei '\.(qmd|tex|R)$' || true)"
    if [ -n "$STAGED" ]; then
        n="$(printf '%s\n' "$STAGED" | grep -c .)"
        echo ""
        echo "── pre-commit: quality score (>= 80) on ${n} staged file(s) ──"
        # Score each file individually: portable (no mapfile/bash4), handles
        # spaces in paths, and gives a per-file exit code we can classify.
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            [ -f "$f" ] || continue
            python3 scripts/quality_score.py "$f"
            rc=$?
            # quality_score.py: rc 2 = auto-fail (compile/syntax FAILURE), rc 1 =
            # score < 80 (or scorer error / file-not-found). BOTH must block — a
            # file that fails to compile is the worst case, not an "infra error".
            if [ "$rc" -ne 0 ]; then
                echo "✗ quality gate: '$f' failed (rc=$rc — 2=compile/syntax failure, 1=score<80 or scorer error)." >&2
                FAIL=1
            fi
        done <<< "$STAGED"
    else
        echo ""
        echo "── pre-commit: no staged .qmd/.tex/.R files to score ──"
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo "" >&2
    echo "✗ pre-commit gate failed — commit aborted." >&2
    echo "  Fix the findings above, or (sparingly) bypass with SKIP_QUALITY_GATE=1 / --no-verify." >&2
    exit 1
fi

echo ""
echo "✓ pre-commit gates passed."
exit 0
